# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local artifacts
supabase/.branches/
supabase/.temp/

# test artifacts
test-results/
tests/e2e/.auth/
playwright-report/

# claude code
.claude/
!.claude/commands/

# orchestrator logs (local only, not committed)
docs/orchestrator-logs/

# security audit (local only, contains sensitive context)
security/

# James's study framework design workspace (HTML prototypes, Excel drafts, images)
frameworks/

# James's market research working dir (reddit scrapes, xlsx drafts, reference data)
market-research/

# Point-in-time generated codebase references — stay on disk, not tracked
docs/cpa-codebase-guide.md
docs/cpa-codebase-guide.pdf

# verified-ids.json backup snapshots — daily filesystem backup covers recovery
docs/verified-ids.json.pre-*.bak

# classifier incremental-save files — regenerated on every classify-section.ts
# run, not meaningful state. The final classify-<section>.json is authoritative.
docs/classify-*.partial.json

.vercel
.env*.local
